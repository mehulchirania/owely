# Owely environment variables. Copy to .env.local and fill the TODOs.
# Firebase project: owely-c6c51 (project number 167116474777)

# --- Firebase Web (client) config: NEXT_PUBLIC_*, safe to expose ---
# apiKey + appId come from: Firebase console > Project settings > Your apps >
# register a Web app if none exists. The rest are derived from the project id.
NEXT_PUBLIC_FIREBASE_API_KEY=TODO_FROM_CONSOLE
NEXT_PUBLIC_FIREBASE_APP_ID=TODO_FROM_CONSOLE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=owely-c6c51.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=owely-c6c51
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=owely-c6c51.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=167116474777

# --- Admin SDK (server only): NEVER commit the real value ---
# Service account: Firebase console > Project settings > Service accounts >
# Generate new private key. Paste the JSON on one line, or base64-encode it.
# Paid receipt OCR also uses this service account; enable the Google Cloud
# Vision API for the project before calling POST /api/receipts/ocr in prod.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Recurring expenses cron ---
# Shared secret for POST /api/cron/recurring. Point Cloud Scheduler at that
# endpoint daily with header `Authorization: Bearer <this value>`.
CRON_SECRET=

# --- Admin panel ---
# Required in production. Local development falls back to admin/admin only when
# these are unset and NODE_ENV is not production.
OWELY_ADMIN_USERNAME=
OWELY_ADMIN_PASSWORD=

# --- App URL (used in server-side invite SMS links) ---
# Set to your deployed App Hosting URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SMS (Twilio) — optional; stub logs to console when unset ---
# Console: twilio.com > Account > API Keys & Tokens
# TWILIO_FROM_NUMBER is the purchased Twilio phone number, e.g. +15551234567
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Razorpay — optional; payments return 503 when unset ---
# Dashboard: razorpay.com > Settings > API Keys (use Test keys locally)
# RAZORPAY_WEBHOOK_SECRET: Razorpay dashboard > Webhooks > your endpoint > secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
