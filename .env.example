# Owely — environment variables. Copy to .env.local and fill the two TODOs.
# Firebase project: owely-c6c51 (project number 167116474777)

# --- Firebase Web (client) config — NEXT_PUBLIC_*, safe to expose ---
# apiKey + appId come from: Firebase console > Project settings > Your apps >
# (register a Web app if none exists). The rest are derived from the project id.
NEXT_PUBLIC_FIREBASE_API_KEY=TODO_FROM_CONSOLE
NEXT_PUBLIC_FIREBASE_APP_ID=TODO_FROM_CONSOLE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=owely-c6c51.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=owely-c6c51
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=owely-c6c51.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=167116474777

# --- Admin SDK (server only) — NEVER commit the real value ---
# Service account: Firebase console > Project settings > Service accounts >
# Generate new private key. Paste the JSON on one line, or base64-encode it.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Recurring expenses cron ---
# Shared secret for POST /api/cron/recurring. Point Cloud Scheduler at that
# endpoint daily with header `Authorization: Bearer <this value>`.
CRON_SECRET=
